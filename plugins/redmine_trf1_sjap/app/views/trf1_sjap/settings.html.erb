<h2><%= l(:label_trf1_sjap)%> &#187; <%= l(:label_settings)%></h2>

<% if ! @trf1_sjap_project.new_record? %>
<%= link_to('Testar login no e-Admin', {:action => 'eadmin_test_login', :project_id => @project.id}) %>
<% end%>

<%= labelled_form_for @trf1_sjap_project, :url => {:action => 'settings', :project_id => @project } do |f| %>
<%= error_messages_for 'trf1_sjap_project' %>
<div class="box">
	<p>
		<label for="trf1_sjap_project_eadmin_matricula"><%= l(:field_eadmin_matricula)%> <span class="required">*</span></label>
		<%= text_field 'trf1_sjap_project', 'eadmin_matricula' %>
	</p>
	<p>
		<label for="trf1_sjap_project_eadmin_senha"><%= l(:field_eadmin_senha)%> <span class="required">*</span></label>
		<%= password_field 'trf1_sjap_project', 'eadmin_senha' %>
	</p>
	<p>
		<label for="trf1_sjap_project_eadmin_banco"><%= l(:field_eadmin_banco)%> <span class="required">*</span></label>
		<%= text_field 'trf1_sjap_project', 'eadmin_banco' %>
	</p>
</div>

<%= submit_tag l(:button_save) %>
<% end %>
