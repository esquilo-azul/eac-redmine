<p>
	<label>Tracker de exportação de solicitações e-Sosti para issues Redmine.</label>
	<select name="settings[tracker_id]">
		<%= options_for_select(Tracker.all.collect {|p| [ p.name, p.id ] }, settings['tracker_id'] ) %>
	</select>
</p>

<p>
	<label>Usuário administrador</label>
	<select name="settings[admin_user_id]">
		<%= options_for_select(User.all.order('firstname','lastname').collect {|u| [ u.to_s, u.id ] }, settings['admin_user_id'] ) %>
	</select>
</p>

<p>
	<label>Limite de requisições simultâneas ao e-Admin</label>
	<%= number_field_tag 'settings[eadmin_request_limit]', settings['eadmin_request_limit'] %>	
</p>

<p>
	<label>Pausa entre requisições de um <em>thread</em> ao e-Admin</label>
	<%= number_field_tag 'settings[eadmin_request_pause]', settings['eadmin_request_pause'] %>	
</p>

<p>
	<label>Situação de tarefa que indica que ela está bloqueada por outras tarefas ou pela data de início.</label>
	<select name="settings[block_issue_status_id]">
		<%= options_for_select(IssueStatus.all.collect {|p| [ p.name, p.id ] }, settings['block_issue_status_id'] ) %>
	</select>
</p>