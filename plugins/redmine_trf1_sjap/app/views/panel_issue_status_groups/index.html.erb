<div class="contextual">
  <%= link_to l(:label_panel_issue_status_group_new), new_panel_issue_status_group_path, :class => 'icon icon-add' %>
</div>

<h2><%= l(:label_panel_issue_status_groups)%></h2>

<table class="list">
  <thead>
    <tr>
      <th><%= l(:field_name)%></th>
      <th><%= l(:field_empty_message)%></th>
      <th><%= l(:field_permanent)%></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @panel_issue_status_groups.each do |group| %>
    <tr class="<%= cycle("odd", "even") %>">
      <td style="text-align: left"><%= link_to h(group.name), edit_panel_issue_status_group_path(group) %></td>
      <td style="text-align: center"><%= group.empty_message %></td>
      <td style="text-align: center"><%= checked_image(group.permanent)%></td>
      <td class="buttons"> <%= delete_link panel_issue_status_group_path(group) %> </td>
    </tr>
    <% end %>
  </tbody>
</table>