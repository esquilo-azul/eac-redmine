<h2>Alerta e-Sosti</h2>

<table>
	<tr>
		<td rowspan="2">
			<table>
				<tr>
					<td align="right"><label for="matricula">Matrícula:</label></td>
					<td align="left"><%= text_field_tag 'matricula', params[:matricula], :tabindex => '1' %></td>
				</tr>
				<tr>
					<td align="right"><label for="senha">Senha do e-Admin:</label></td>
					<td align="left"><%= password_field_tag 'senha', nil, :tabindex => '2' %></td>
				</tr>
				<tr>
					<td align="right"><label for="banco">Banco:</label></td>
					<td align="left"><%= text_field_tag 'banco', params[:banco], :tabindex => '3' %></td>
				</tr>
				<tr>
					<td align="right"><label for="intervalo">Intervalo de atualização:</label></td>
					<td align="left"><%= number_field_tag 'intervalo', params[:intervalo], :tabindex => '4', :min => 1 %></td>	
				</tr> 
				<tr>
					<td align="right"></td>
					<td align="left"><%= button_tag "Atualizar", id: 'updateButton', class: "button-small" %></td>
				</tr>
			</table>
		</td>
		<td id="updateStatus"></td>
	</tr>
	<tr>
		<td id="resultContainer">&nbsp;</td>
	</tr>
</table>

<%= javascript_include_tag('esosti_alerta') %>

<script type="text/javascript">
	EsostiAlerta.ESOSTI_ALERTA_DATA_PATH = '<%= esosti_alerta_data_path %>';
	EsostiAlerta.start();
	$('#updateButton').bind('click', function(){
		EsostiAlerta.update();
	});
</script>
