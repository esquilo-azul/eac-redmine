<p>
  <strong>Data/hora da atualização: </strong><%= Time.now.strftime("%m/%d/%Y %H:%M:%S") %>
</p>

<p>
  <strong>Resultado do login: </strong><%= @login_message %>
</p>

<% if @solicitacoes != nil %>
  <p>
    <strong>Nº de solicitações: </strong><%= @solicitacoes.length.to_s %>
  </p>

  <p>
    <strong>Nova solicitação: </strong><%= @nova_solicitacao ? 'Sim' : 'Não' %>
  </p>

  <% if @nova_solicitacao %>
    <p>
      <%= audio_tag('esosti_alerta.ogg', autoplay: true) %>
    </p>
  <% end %>

  <p id="unidades_filter" >
    <strong>Unidades: </strong>
    <% @unidades_filter_options.each do |k, v|  %>
      <span class="unidade_filter_option" >
        <%= check_box_tag 'unidade[]', k, class: 'unidade_filter_option' %><%= v %>
      </span>
    <%  end %>
  </p>

  <table class="list">
    <thead>
      <tr>
        <th>Número</th>
        <th>Solicitante</th>
        <th>Serviço Atual</th>
        <th>Atendente</th>
      </tr>
    </thead>
    <tbody>
      <% if @solicitacoes.length == 0 %>
        <tr>
          <td><em>Sem solicitações no momento</em></td>
        </tr>
      <% else %>
        <% for s in @solicitacoes %>
          <tr class="<%= cycle("odd", "even") %>" >
            <td><%= s[:numero]%></td>
            <td><%= s[:solicitante]%></td>
            <td><%= s[:servico_atual]%></td>
            <td><%= s[:atendente]%></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% end %>
