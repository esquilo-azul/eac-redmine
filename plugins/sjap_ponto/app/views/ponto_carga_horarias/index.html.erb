<div class="contextual">
  <%= link_to l(:label_ponto_carga_horaria_new), new_ponto_carga_horaria_path, :class => 'icon icon-add' %>
</div>

<%
can_cancel = UserRole.user_has_role('ponto_carga_horaria_cancelamento')
%>

<h2><%= l(:label_ponto_carga_horaria_plural)%></h2>

<%= form_tag(ponto_carga_horarias_path, :method => :get) do %>
  <fieldset>
    <legend><%= l(:label_filter_plural) %></legend>
    <label for='funcionario'><%= l(:field_funcionario) %>:</label>
    <%= select_tag 'funcionario',  funcionario_options_for_select(@funcionario), :class => "small", :onchange => "this.form.submit(); return false;"  %>
    <%= submit_tag l(:button_apply), :class => "small", :name => nil %>
    <%= link_to l(:button_clear), ponto_carga_horarias_path, :class => 'icon icon-reload' %>
  </fieldset>
<% end %>

<div class="autoscroll">
  <table class="list">
    <thead><tr>
        <%= sort_header_tag('descricao', :caption => l(:field_descricao)) %>
        <%= sort_header_tag('data_inicial', :caption => l(:field_data_inicial)) %>
        <%= sort_header_tag('data_final', :caption => l(:field_data_final)) %>        
        <%= sort_header_tag('minutos_continuo', :caption => l(:field_minutos_continuo)) %>
        <%= sort_header_tag('minutos_descontinuo', :caption => l(:field_minutos_descontinuo)) %>
        <th><%= l(:field_autor)%></th>
        <th><%= l(:field_funcionarios)%></th>
        <th><%= l(:field_cancelamento)%></th>
        <% if UserRole.user_has_role('ponto_carga_horaria_cancelamento')  %>
          <th>Ações</th>
        <% end %>
      </tr></thead>
    <tbody>
      <% @rows.each do |pch| %>
        <tr class="<%= cycle("odd", "even") %>">
          <td><%= pch.descricao %></td>
          <td><%= pch.data_inicial %></td>
          <td><%= pch.data_final %></td>
          <td><%= pch.minutos_continuo %></td>
          <td><%= pch.minutos_descontinuo %></td>
          <td><%= pch.autor %></td>
          <td><%= render 'funcionarios_column', funcionarios: pch.funcionarios %></td>
          <td><%= render 'cancelamento_column', cancelamento: pch.cancelamento %></td>
          <% if UserRole.user_has_role('ponto_carga_horaria_cancelamento') &&  %>
            <td>
              <% if pch.cancelamento %>
                -
              <% else %>
                <%= link_to('Cancelar', cancelamento_ponto_carga_horaria_path(pch)) %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end -%>
    </tbody>
  </table>
</div>
<p class="pagination"><%= pagination_links_full @rows_pages, @rows_count %></p>