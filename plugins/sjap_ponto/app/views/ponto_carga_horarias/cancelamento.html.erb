<div class="contextual">
  <%= link_to l(:label_ponto_carga_horaria_plural), ponto_carga_horarias_path %>
</div>

<h2><%= l(:label_ponto_carga_horaria_cancelamento_new)%></h2>

<%= labelled_form_for @ponto_carga_horaria_cancelamento, url: cancelamento_post_ponto_carga_horaria_path(@ponto_carga_horaria_cancelamento.ponto_carga_horaria) do |f| %>
  <%= error_messages_for 'ponto_carga_horaria_cancelamento' %>
  <p>
    <strong><%=  l(:field_ponto_carga_horaria) %>:</strong>
    <%= @ponto_carga_horaria_cancelamento.ponto_carga_horaria %>
  </p>
  <div class="box tabular">
    <p>
      <%= f.text_field :motivo %>
    </p>
  </div>
  <%= submit_tag l(:button_create) %>
<% end %>
