<h2><%= l(:label_ponto_entrada_manual_new)%></h2>
<%= labelled_form_for @ponto_entrada_manual, url: ponto_entrada_manual_index_path do |f| %>
  <%= error_messages_for @ponto_entrada_manual %>
  <div class="box tabular">
    <p>
      <%= f.select :funcionario_id, Funcionario.order(nome: :asc).all.collect {|p| [ p.nome, p.id ] }, {include_blank: '-- SELECIONE --'}%>
    </p>
    <p>
      <label>Data</label>
      <%= f.select :dia, @dias, no_label: true %> /
      <%= f.select :mes, @meses, no_label: true %> /
      <%= f.select :ano, @anos, no_label: true %> 
    </p>
    <p>
      <label>Hora</label>
      <%= f.select :hora, @horas, no_label: true %> : 
      <%= f.select :minuto, @minutos, no_label: true %>
    </p>
    <p>
      <label>Fuso horario</label>
      <span><%=  @ponto_entrada_manual.time_zone.formatted_offset %> (<%= @ponto_entrada_manual.time_zone.name %>)</span>
    </p>
    <p>
      <%= f.text_field :motivo %>
    </p>
  </div>
  <%= submit_tag l(:button_create) %>
<% end %>
