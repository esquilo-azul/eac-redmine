<p>Funcionário: <%= @frequencia_relatorio.funcionario %></p>
<p>Mês/ano: <%= @frequencia_relatorio.mes %>/<%= @frequencia_relatorio.ano %></p>

<table class="list">
  <thead>
    <tr>
      <th><%= l(:field_dia)%></th>
      <th><%= l(:field_dia_semana)%></th>
      <th><%= l(:field_carga_horaria_descricao)%></th>      
      <th><%= l(:field_intervalos_executados)%></th>
      <th><%= l(:field_horas_executadas)%></th>
      <th><%= l(:field_horas_devidas)%></th>
      <th><%= l(:field_horas_saldo)%></th>
    </tr>
  </thead>
  <tbody>
    <% @datas.each do |d| %>
      <tr class="<%= cycle("odd", "even") %>">
        <td style="text-align: center"><%= format_dia(d) %></td>
        <td style="text-align: center"><%= format_dia_semana(d) %></td>
        <td style="text-align: center"><%= format_horario_descricao(d) %></td>        
        <td style="text-align: center"><%= format_intervalos_executados(d) %></td>
        <td style="text-align: center"><%= format_horas_executadas(d) %></td>
        <td style="text-align: center"><%= format_horas_devidas(d) %></td>
        <td style="text-align: center"><%= format_horas_saldo(d) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <th colspan="4" style="text-align: center">Total </th>
      <th style="text-align: center"><%= format_horas_executadas_total(@datas) %></th>
      <th style="text-align: center"><%= format_horas_devidas_total(@datas) %></th>
      <th style="text-align: center"><%= format_horas_saldo_total(@datas) %></th>
    </tr>
  </tfoot>
</table>
