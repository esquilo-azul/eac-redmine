<h3>Busca</h3>
<%= labelled_form_for @frequencia_relatorio do |f| %>
  <%= error_messages_for 'frequencia_relatorio' %>
  <div class="box tabular">
    <p>
      <label>Funcionário</label>
      <%= multi_funcionario_input f, :funcionario_id %>
    </p>
    <p>
      <label>Mês inicial: </label>
      <%= f.select :inicio_mes, @meses, no_label: true %> / 
      <%= f.select :inicio_ano, @anos, no_label: true%>
    </p>
    <p>
      <label>Mês final: </label>
      <%= f.select :fim_mes, @meses, no_label: true %> / 
      <%= f.select :fim_ano, @anos, no_label: true%>
    </p>
  </div>
  <%= submit_tag 'Consultar' %>
<% end %>
