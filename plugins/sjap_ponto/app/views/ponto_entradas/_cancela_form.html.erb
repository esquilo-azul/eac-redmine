<ol class="form">
  <% [:data_hora, :funcionario, :metodo, :autor].each do |column| %>
    <li class="form-element">
      <%= t("field_#{column}") %>:
      <%= @ponto.send(column) %>
    </li>
  <% end %>

  <li class="form-element">
    <%= form_attribute(@column, @record, scope) %>
  </li>
</ol>